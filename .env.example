# ── Which version of Lockpad to run ─────────────────────────────────────────
# The image tag docker-compose.public.yml pulls. install.sh writes the release it
# installed, and leaving it pinned is the point: unset, Compose falls back to
# `latest`, which is rebuilt on every push to the source repository — so the app
# would change underneath you whenever someone committed. Pinned, it changes only
# when you edit this line and run `docker compose pull && docker compose up -d`.
# The backend applies any new database migrations itself on startup.
#
# Move FORWARD only. Migrations run in one direction, so a database upgraded by a
# newer release is not something an older one can be pointed back at. Check
# Settings → About for where you are now, and export from Settings → Data first.
TAG=v1.0.0

# ── Postgres ────────────────────────────────────────────────────────────────
# These configure the internal `postgres` container. It is NEVER published to
# the host or the public internet — only the `backend` container reaches it over
# the internal Docker network.
POSTGRES_USER=lockpad
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=lockpad

# ── Backend ─────────────────────────────────────────────────────────────────
# Prisma connection string. Host is the compose service name `postgres`.
DATABASE_URL=postgresql://lockpad:change-me-to-a-long-random-string@postgres:5432/lockpad?schema=public
BACKEND_PORT=4000
# Where request/error logs are written (mounted to a NAS volume in compose).
LOG_DIR=/var/log/lockpad
# Comma-separated allowed origins. Behind `tailscale serve` this is your
# MagicDNS name, e.g. https://lockpad.your-tailnet.ts.net
CORS_ORIGINS=http://localhost:5173

# ── App auth ────────────────────────────────────────────────────────────────
# Single login password for the app. Leave EMPTY to disable auth (open access —
# only sensible on a trusted tailnet). Set it to require a password.
APP_PASSWORD=
# Signs the session token. Generate one: `openssl rand -hex 32`. Required when
# APP_PASSWORD is set.
SESSION_SECRET=
# true only when served over HTTPS (e.g. `tailscale serve`); false for plain
# HTTP over the tailnet.
COOKIE_SECURE=false

# ── Tailscale sidecar (optional) ──────────────────────────────────────────────
# Only needed with docker-compose.tailscale.yml. Generate a key at
# login.tailscale.com → Settings → Keys. Serves Lockpad at
# https://lockpad.<your-tailnet>.ts.net (set COOKIE_SECURE=true when using it).
# TS_AUTHKEY=

# ── Frontend ────────────────────────────────────────────────────────────────
# Base URL the SPA uses to reach the API. Same-origin in production (backend
# serves the static bundle), so this can be left as "/api".
VITE_API_BASE_URL=/api
FRONTEND_PORT=5173
# Host interface the frontend binds to. Default (unset) = 127.0.0.1 (localhost
# only; front with `tailscale serve`). Set empty to bind 0.0.0.0 (LAN + tailnet),
# or "<ip>:" for a specific interface. Only expose after APP_PASSWORD is set —
# broadening this WITHOUT a password leaves every unlocked note readable by anyone
# on the network. The server warns about that combination at startup and in the app.
# FRONTEND_BIND=

# Direct HTTPS on your LAN, no Tailscale client required on the machine you are
# using (overlay: docker-compose.lan-tls.yml, setup: DEPLOY.md §9). Plain HTTP is
# deliberately not the answer here — browsers withhold crypto.subtle outside a
# secure context, so per-note locking cannot work over http://<nas-ip>.
# FRONTEND_TLS_PORT=5174
# Interface for the TLS port. Default (unset) = every interface, which is the
# point of this overlay. Set "<ip>:" to pin it to one network.
# FRONTEND_TLS_BIND=

# ---------------------------------------------------------------------------
# Which compose files every `docker compose` command in this directory uses.
#
# Overlays are opt-in, and each one is normally a `-f` flag you must repeat on
# EVERY later command. Forgetting one is silent: recreating the frontend without
# docker-compose.lan-tls.yml drops its 5174 port, the container still reports
# healthy, and the app just stops answering on the LAN. Setting this makes a bare
# `docker compose up -d` carry the whole set instead, so an update cannot undo
# your setup. Separate paths with ":", and list only what you actually run.
# See DEPLOY.md §3.
# COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml:docker-compose.lan-tls.yml

# ── Rate limiting ────────────────────────────────────────────────────────────
# Per-client request ceilings. The defaults are far above anything a person
# produces (600 requests/minute overall; 10 login attempts per 15 minutes) and
# exist to stop a runaway client or a password-guessing script, not to throttle
# you. Raise them if you drive the API from a script of your own.
# RATE_LIMIT_MAX=600
# RATE_LIMIT_WINDOW_MS=60000
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Honour X-Forwarded-For so the rate limiter can tell clients apart behind the
# bundled nginx. Defaults to true in production; only set this to false if you
# expose the backend port directly, where the header could be forged.
# TRUST_PROXY=true
