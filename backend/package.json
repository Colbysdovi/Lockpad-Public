{
  "name": "lockpad-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:preview": "tsx test/dev-server.mts",
    "dev:preview:firstrun": "SEED=none tsx test/dev-server.mts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-isolation=process --import tsx test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^6.1.0",
    "csv-parse": "^5.6.0",
    "fastify": "^5.2.0",
    "jose": "^5.10.0",
    "marked": "^15.0.4",
    "node-html-parser": "^9.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "fsevents@2.3.3": true
  }
}
